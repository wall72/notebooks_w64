   "source": [
    "import tensorflow as tf\n",
    "\n",
    "a = tf.constant(2)\n",
    "b = tf.constant(3)\n",
    "\n",
    "with tf.Session() as sess:\n",
    "    print('a = 2, b = 3')\n",
    "    print('addition with constants: %i' % sess.run(a + b))\n",
    "    print('Multiplication with constants: %i' % sess.run(a * b))"
   ]
  }
